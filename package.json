{
    "name": "astro-notion-boilerplate",
    "type": "module",
    "version": "0.0.1",
    "scripts": {
        "clear": "rm -rf dist .astro .netlify node_modules",
        "clean": "rm -rf dist .astro .netlify",
        "dev": "npm run sync:notion-images && astro dev",
        "sync:notion-images": "node scripts/sync-notion-images.mjs",
        "prune:notion-images": "node scripts/sync-notion-images.mjs --prune",
        "build": "npm run sync:notion-images && astro sync && astro build",
        "preview": "astro preview",
        "astro": "astro"
    },
    "dependencies": {
        "@astrojs/netlify": "^8.2.9",
        "@netlify/blobs": "^11.1.4",
        "@notionhq/client": "^5.27.0",
        "astro": "^7.3.8"
    },
    "devDependencies": {
        "@astro-notion/loader": "^1.1.2"
    }
}
