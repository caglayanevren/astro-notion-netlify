---
import { Image } from 'astro:assets';

interface Props {
  filename: string;        // örn: "post-1-cover.jpg" — content collection'dan gelir
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const {
  filename,
  alt,
  widths = [400, 800, 1200],
  sizes = '(max-width: 800px) 100vw, 800px',
  class: className,
  loading = 'lazy',
} = Astro.props;

// KRİTİK: glob pattern'i STATİK bir string literal olmalı.
// Vite bunu build-time'da analiz edip eşleşen tüm dosyaları önceden bundle eder.
// `filename` değişkenini pattern'in İÇİNE koyamazsın (import.meta.glob(`...${filename}`) ÇALIŞMAZ).
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/notion/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const key = `${filename}`;
const match = images[key];

if (!match) {
  throw new Error(
    `ImageWrapper: "${filename}" bulunamadı. Mevcut dosyalar: ${Object.keys(images)
      .map((k) => k.split('/').pop())
      .join(', ')}`
  );
}
---

<Image
  src={match.default}
  alt={alt}
  widths={widths}
  sizes={sizes}
  format="webp"
  quality={80}
  loading={loading}
  class={className}
/>