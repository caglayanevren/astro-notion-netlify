---
import { Image } from 'astro:assets';
import { notionImageAssets } from '../../assets/notion-image-assets';

interface Props {
  filename: string;        // örn: "post-1-cover.jpg" — content collection'dan gelir
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const {
  filename,
  alt,
  widths = [400, 800, 1200],
  sizes = '(max-width: 800px) 100vw, 800px',
  class: className,
  loading = 'lazy',
} = Astro.props;

const key = `${filename}`;
const match = notionImageAssets[key as keyof typeof notionImageAssets];

if (!match) {
  throw new Error(
    `ImageWrapper: the prepared asset "${filename}" is missing. Run sync:notion-images before building.`
  );
}
---

<Image
  src={match}
  alt={alt}
  widths={widths}
  sizes={sizes}
  format="webp"
  quality={80}
  loading={loading}
  class={className}
/>
